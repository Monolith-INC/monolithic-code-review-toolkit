{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monolith.inc/mcrt/review-harness/sources-v2.schema.json",
  "title": "MCRT sources.json v2",
  "type": "object",
  "required": ["version", "scm", "tracker"],
  "properties": {
    "version": {"const": 2},
    "scm": {"$ref": "#/$defs/source"},
    "tracker": {"$ref": "#/$defs/source"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["capabilities", "unsupported"],
      "properties": {
        "capabilities": {"type": "object", "propertyNames": {"enum": ["fetch_parent", "fetch_work_item", "get_pull_request", "get_pull_request_diff", "list_conversation_comments", "list_linked_artifacts", "list_review_threads", "post_inline_comment", "post_summary_comment", "reply_to_review_thread"]}, "additionalProperties": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "server", "tool", "access", "effect"], "properties": {"kind": {"const": "mcp_tool"}, "server": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}, "tool": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}, "access": {"enum": ["read", "write"]}, "effect": {"type": "string"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "program", "args", "access", "effect"], "properties": {"kind": {"const": "command"}, "program": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}, "args": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "access": {"enum": ["read", "write"]}, "effect": {"type": "string"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "path", "access", "effect"], "properties": {"kind": {"const": "path"}, "path": {"type": "string"}, "access": {"const": "read"}, "effect": {"type": "string"}}}]}},
        "unsupported": {"type": "array", "items": {"enum": ["fetch_parent", "fetch_work_item", "get_pull_request", "get_pull_request_diff", "list_conversation_comments", "list_linked_artifacts", "list_review_threads", "post_inline_comment", "post_summary_comment", "reply_to_review_thread"]}}
      }
    }
  },
  "x-mcrt-core-contract-version": 1,
  "x-mcrt-effects": {"fetch_parent": "tracker.work_item.read", "fetch_work_item": "tracker.work_item.read", "get_pull_request": "scm.pull_request.read", "get_pull_request_diff": "scm.pull_request.read", "list_conversation_comments": "scm.comment.read", "list_linked_artifacts": "tracker.artifact.read", "list_review_threads": "scm.review_thread.read", "post_inline_comment": "scm.comment.create", "post_summary_comment": "scm.comment.create", "reply_to_review_thread": "scm.review_thread.reply"},
  "x-mcrt-write-capabilities": ["post_inline_comment", "post_summary_comment", "reply_to_review_thread"]
}
